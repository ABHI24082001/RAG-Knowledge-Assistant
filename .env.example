# Application
APP_ENVIRONMENT=production
PORT=8000
LOG_LEVEL=INFO
# Comma-separated public frontend origins. Do not use * with credentials.
ALLOWED_ORIGINS=https://YOUR_DOMAIN

# Keep `local` only when this directory is on persistent EC2 storage.
QDRANT_MODE=local
QDRANT_PATH=/var/lib/rag-knowledge-assistant/qdrant_storage
QDRANT_TIMEOUT_SECONDS=10
# For a managed Qdrant server or Qdrant Cloud instead:
# QDRANT_MODE=cloud
# QDRANT_URL=https://YOUR_CLUSTER_URL.cloud.qdrant.io
# QDRANT_API_KEY=replace-with-a-secret-from-qdrant

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
LLM_MODEL_NAME=HuggingFaceTB/SmolLM2-360M-Instruct
RAG_LLM_DEVICE=cpu
HF_HUB_DISABLE_XET=1
HF_HOME=/var/lib/rag-knowledge-assistant/huggingface
